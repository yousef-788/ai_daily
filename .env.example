# هذا الملف مرجع فقط (Template) لمتغيرات البيئة التي سنحتاجها لاحقًا.
# لا تضع بيانات حقيقية هنا، وأنشئ نسخة باسم .env عند الحاجة الفعلية.

# مفتاح Anthropic API - سنحتاجه في مرحلة تلخيص المحتوى بالـ AI القادمة.
ANTHROPIC_API_KEY=

# (اختياري) أقصى عدد أخبار يتم تلخيصها بالـ AI في التشغيلة الواحدة،
# للتحكم في التكلفة. الافتراضي لو مش محدد: 30.
# AI_MAX_SUMMARIES_PER_RUN=30

# (اختياري) الأقسام (category) اللي هيتفعّل عليها التلخيص، مفصولة بفاصلة.
# الافتراضي: "news" بس (الأدوات والوظائف أصلًا مختصرة ومش محتاجة تلخيص).
# مثال لتفعيله على كل الأقسام: AI_SUMMARY_CATEGORIES=news,tools,jobs
# AI_SUMMARY_CATEGORIES=news

# النشر الفعلي في قناة واتساب عبر WAHA (اختياري). لازم الثلاثة متوفرين
# مع بعض عشان يتفعّل، وإلا هيتم الاكتفاء بحفظ نسخة محلية في data/drafts.
# WAHA_BASE_URL=https://your-app.up.railway.app
# WAHA_API_KEY=
# WHATSAPP_CHANNEL_ID=123456789012345678@newsletter

# سيُضاف لاحقًا عند الحاجة الفعلية، مثال:
# WHATSAPP_API_TOKEN=
# DATABASE_URL=
