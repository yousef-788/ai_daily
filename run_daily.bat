@echo off
REM run_daily.bat
REM --------------
REM سكربت بسيط يشغّل مشروع AI Daily، مصمم ليُستخدم كنقطة دخول لجدولة
REM Windows Task Scheduler. مش لازم تشغّله يدويًا؛ اتفعل تلقائيًا حسب
REM الجدول اللي هتظبطه في Task Scheduler.
REM
REM ملحوظة: عدّل السطر بتاع "cd" تحت لو مسار المشروع مختلف عندك.

cd /d "C:\Users\m\Desktop\ai_daily"

REM تشغيل المشروع باستخدام بايثون مباشرة (بدل الاعتماد على أمر ai-daily
REM اللي محتاج الـ PATH يكون متظبط صح وقت التشغيل غير التفاعلي).
python -m ai_daily.main

REM لو حابب تتأكد إن التشغيلة خلصت صح وقت التجربة اليدوية، شيل علامة
REM الـ REM من السطر اللي تحت (هيوقف الشباك مفتوحة تعرض النتيجة).
REM pause
